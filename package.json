{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "claude-devin",
  "version": "0.4.0",
  "description": "Run Claude Code on your Devin subscription — drop-in `claude` wrapper with a local Anthropic-compatible proxy",
  "type": "module",
  "bin": {
    "claude-devin": "./cli.mjs"
  },
  "files": [
    "cli.mjs",
    "proxy-bundle.mjs",
    "src/",
    ".claude-plugin/",
    "commands/"
  ],
  "scripts": {
    "build": "bun build src/devin-anthropic-proxy/bundle-entry.ts --target node --outfile proxy-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "keywords": [
    "claude-code",
    "devin",
    "cognition",
    "anthropic",
    "proxy",
    "cascade",
    "windsurf"
  ],
  "license": "MIT",
  "author": {
    "name": "JoShMiQueL",
    "email": "joshmiquel.cs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/claude-devin.git"
  },
  "homepage": "https://github.com/JoShMiQueL/claude-devin#readme",
  "bugs": "https://github.com/JoShMiQueL/claude-devin/issues",
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
